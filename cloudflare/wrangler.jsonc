{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "k4-remote-diagnostics",
  "main": "remote-diagnostics-worker.js",
  "compatibility_date": "2026-11-06",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "k4-remote-diagnostics",
      "database_id": "a6b972e2-0fc2-4bfa-887d-5690ba10bfd3",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMIT_RATE_LIMIT",
      "namespace_id": "2001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "GMAIL_RELAY_URL": "https://script.google.com/macros/s/AKfycbyJZGa2AcZyLEzb0fhq5JnLCm9KeRW5XH_Sz1mc_b-Pg-IcBhiRBADx3chQ_pa1DEypRQ/exec"
  }
}
