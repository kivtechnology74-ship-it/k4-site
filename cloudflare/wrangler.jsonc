{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "k4-remote-diagnostics",
  "main": "remote-diagnostics-worker.js",
  "compatibility_date": "2026-11-06",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "routes": [
    "k4-technology.com/api/remote-diagnostics*",
    "www.k4-technology.com/api/remote-diagnostics*",
    "k4-technology.com/api/calculator-events*",
    "www.k4-technology.com/api/calculator-events*"
  ],
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "k4-remote-diagnostics",
      "database_id": "a6b972e2-0fc2-4bfa-887d-5690ba10bfd3",
      "migrations_dir": "migrations"
    },
    {
      "binding": "PREVIEW_LEADS_DB",
      "database_name": "k4-site-leads-preview",
      "database_id": "42d1526a-e2c2-45f9-8071-c12fe3e57b26"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMIT_RATE_LIMIT",
      "namespace_id": "2001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "CALCULATOR_EVENT_RATE_LIMIT",
      "namespace_id": "2002",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
